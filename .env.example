# Monad testnet account used by the store to pin hashes.
# Never commit a real key. --ci reads this from the environment.
# ./scripts/e2e.sh --local does not use this file.
PRIVATE_KEY=

# Official Monad testnet RPC. The e2e script falls back to the backup if this fails.
RPC_URL=https://testnet-rpc.monad.xyz
RPC_URL_BACKUP=https://rpc-testnet.monadinfra.com

# Optional. Reuse a deployed WyrvelSeal instead of deploying again.
WYRVEL_CONTRACT=

# Store process. Defaults are fine for a local tour.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./store/data
